    "/network": {
      "get": {
        "summary": "Network hierarchy",
        "tags": [
          "Network"
        ],
        "description": "Zone → circle → division → subdivision → substation → feeder → DT → meter ids. Nodes are keyed by path, so a feeder that the data places under two substations appears under both; see /network/issues for the list.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stats": {
                      "type": "object",
                      "properties": {
                        "meters": {
                          "type": "integer"
                        },
                        "transformers": {
                          "type": "integer"
                        },
                        "feeders": {
                          "type": "integer"
                        },
                        "substations": {
                          "type": "integer"
                        },
                        "issueCounts": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "tree": {
                      "type": "array",
                      "items": {
