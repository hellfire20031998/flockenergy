    "/health": {
      "get": {
        "summary": "Service health and snapshot status",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "fixtures"
                      ]
                    },
                    "snapshot": {
                      "type": "object",
                      "properties": {
                        "loaded": {
                          "type": "boolean"
                        },
                        "loadedAt": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "meters": {
                          "type": "integer"
                        },
                        "transformers": {
                          "type": "integer"
                        },
                        "cachedReadingSeries": {
                          "type": "integer"
                        },
                        "lastError": {
                          "type": [
                            "null",
                            "object"
                          ],
                          "additionalProperties": true
                        },
                        "portalSession": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/snapshot/refresh": {
      "post": {
        "summary": "Re-fetch the snapshot from the portal",
        "tags": [
          "System"
        ],
        "description": "The portal data is a frozen June 2026 snapshot, so there is no automatic refresh. Call this if the portal ever changes. Costs 3 portal requests and clears the readings cache.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "refreshed": {
                      "type": "boolean"
                    },
                    "snapshot": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
