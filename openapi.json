    "/network/issues": {
      "get": {
        "summary": "Data-quality issues found in the portal data",
        "tags": [
          "Network"
        ],
        "description": "Blank hierarchy fields (with the value recovered from sibling meters), conflicting names, feeders with more than one parent, orphans. Computed when the snapshot loads.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "blank_hierarchy_field",
            "in": "query",
            "name": "type",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "in": "query",
            "name": "severity",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "counts": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Issue"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
