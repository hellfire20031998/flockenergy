# Copy to .env and fill in. Never commit .env.
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=operator@urja.local
PORTAL_PASSWORD=change-me

# live  = talk to the portal (needs the credentials above)
# fixtures = serve the snapshot in ./fixtures, no network, no credentials
PORTAL_MODE=live

# Minimum spacing between portal requests, in ms. 1000 never trips the portal's rate limit.
PORTAL_MIN_INTERVAL_MS=1000

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
